@startuml
skinparam shadowing false
hide empty members
class Usuario <<implementado>> {
  -id: UUID
  -nome: String
  -nomeUsuario: String
  -senhaHash: String
  -perfil: Perfil
  +getId(): UUID
  +getNome(): String
  +getNomeUsuario(): String
  +getSenhaHash(): String
  +getPerfil(): Perfil
}
enum Perfil <<implementado>> {
  CLIENTE
  EMPRESA
  BANCO
}
class Cliente <<previsto>> {
  -id: UUID
  -rg: String
  -cpf: String
  -endereco: String
  -profissao: String
}
class VinculoEmpregaticio <<previsto>> {
  -id: UUID
  -entidadeEmpregadora: String
  -rendimento: BigDecimal
}
class Agente <<previsto>> {
  -id: UUID
  -razaoSocial: String
}
class Automovel <<previsto>> {
  -id: UUID
  -matricula: String
  -ano: Integer
  -marca: String
  -modelo: String
  -placa: String
}
class PedidoAluguel <<previsto>> {
  -id: UUID
  -dataInicio: LocalDate
  -dataFim: LocalDate
  -status: StatusPedido
  +modificar()
  +cancelar()
}
enum StatusPedido <<previsto>> {
  EM_ANALISE
  APROVADO
  REPROVADO
  CANCELADO
  CONTRATADO
}
class AvaliacaoFinanceira <<previsto>> {
  -id: UUID
  -dataAvaliacao: Instant
  -aprovado: Boolean
  -parecer: String
}
class ContratoAluguel <<previsto>> {
  -id: UUID
  -dataAssinatura: LocalDate
  -valorTotal: BigDecimal
  -tipoPropriedade: TipoPropriedade
}
enum TipoPropriedade <<previsto>> {
  CLIENTE
  EMPRESA
  BANCO
}
class ContratoCredito <<previsto>> {
  -id: UUID
  -numero: String
  -valorConcedido: BigDecimal
  -quantidadeParcelas: Integer
}
Usuario --> Perfil
Usuario "1" -- "0..1" Cliente : conta do cliente
Usuario "1" -- "0..1" Agente : conta do agente
Cliente "1" *-- "0..3" VinculoEmpregaticio : rendimentos
Cliente "1" -- "0..*" PedidoAluguel : solicita
Automovel "1" -- "0..*" PedidoAluguel : solicitado em
Usuario "1" -- "0..*" Automovel : proprietário atual
PedidoAluguel --> StatusPedido
PedidoAluguel "1" -- "0..*" AvaliacaoFinanceira : histórico de pareceres
Agente "1" -- "0..*" AvaliacaoFinanceira : realiza
PedidoAluguel "1" -- "0..1" ContratoAluguel : origina
Usuario "1" -- "0..*" ContratoAluguel : proprietário definido no contrato
ContratoAluguel --> TipoPropriedade
ContratoAluguel "1" -- "0..1" ContratoCredito : financiamento opcional
Agente "1" -- "0..*" ContratoCredito : banco concedente
note right of Usuario
Nome do cliente vem de Usuario.nome.
CLIENTE vincula-se a Cliente;
EMPRESA ou BANCO vincula-se a Agente.
Esses vínculos ainda serão implementados.
end note
note bottom of ContratoCredito
O agente concedente deve ter perfil BANCO.
end note
note bottom of ContratoAluguel
Só existe após aprovação financeira.
O perfil do proprietário deve corresponder
à modalidade definida no contrato.
end note
@enduml
