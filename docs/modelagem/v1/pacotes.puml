@startuml
skinparam shadowing false
package "Construção dinâmica das páginas web" {
  package "React + Vite" {
    [App.jsx] as Tela
    [index.css] as Estilos
    [Cliente HTTP] as ClienteHttp
  }
}
package "Gestão de pedidos e contratos — Spring Boot / MVC" {
  package "br.com.aluguel.config" {
    [SecurityConfig] as Seguranca
    [AgenteInicialConfig] as Provisionamento
  }
  package "br.com.aluguel.controller" {
    [AuthController] as Autenticacao
    [ApiExceptionHandler] as Erros
    [Controllers de clientes, pedidos e contratos\n(previstos)] as Controllers
  }
  package "br.com.aluguel.dto" as Dto
  package "br.com.aluguel.service" {
    [UsuarioService] as UsuarioServico
    [Serviços de clientes, pedidos e contratos\n(previstos)] as Servicos
  }
  package "br.com.aluguel.repository" {
    [UsuarioRepository] as UsuarioRepositorio
    [Repositórios de domínio\n(previstos)] as Repositorios
  }
  package "br.com.aluguel.model" {
    [Usuario e Perfil] as ModelosAtuais
    [Entidades do domínio\n(previstas)] as ModelosFuturos
  }
}
database "Supabase\nPostgreSQL" as Banco
Tela --> Estilos
Tela --> ClienteHttp
ClienteHttp --> Seguranca : HTTPS / JSON / HTTP Basic
Seguranca --> Autenticacao
Seguranca --> Controllers
Autenticacao --> UsuarioServico
Autenticacao --> Dto
Controllers --> Servicos
Controllers --> Dto
UsuarioServico --> UsuarioRepositorio
Servicos --> Repositorios
UsuarioRepositorio --> ModelosAtuais
Repositorios --> ModelosFuturos
UsuarioRepositorio --> Banco : JPA / JDBC
Repositorios --> Banco : JPA / JDBC
Provisionamento --> UsuarioServico
note bottom of Erros
Tratamento centralizado de erros dos controllers.
end note
note bottom of ClienteHttp
O navegador acessa apenas a API.
A senha do PostgreSQL fica no back-end.
Em desenvolvimento, o Vite encaminha /api à porta 8080.
end note
@enduml
